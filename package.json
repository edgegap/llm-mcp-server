{
  "name": "@edgegap/mcp",
  "mcpName": "dev.edgegap/mcp",
  "version": "0.11.0",
  "description": "Check, push, and deploy game servers on Edgegap from your coding agent, with relays for P2P games. Runs locally; your API token never leaves your machine.",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && chmod +x dist/index.js dist/http.js",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "test": "node --test test/unit.test.mjs && node test/package.mjs && node test/skills.mjs && node test/updateskills.mjs && node test/smoke.mjs && node test/guards.mjs && node test/elicit.mjs && node test/newtools.mjs && node test/http.mjs && node test/spec.mjs && node test/snapshot.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "snapshot:update": "node test/snapshot.mjs --update",
    "scan": "node scripts/scan-repo.mjs",
    "start:http": "node dist/index.js --http",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --local --port 8787",
    "worker:check": "wrangler deploy --config worker/wrangler.jsonc --dry-run --outdir=.wrangler/dryrun",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "prepublishOnly": "npm run build",
    "sync-skills": "node scripts/sync-skills.mjs",
    "check-skills": "node scripts/sync-skills.mjs --check",
    "test:worker": "node test/worker-telemetry.mjs",
    "bundle": "node scripts/build-mcpb.mjs"
  },
  "keywords": [
    "mcp",
    "edgegap",
    "game-server",
    "multiplayer",
    "unity",
    "unreal"
  ],
  "author": "Mathieu Duperre",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgegap/edgegap-mcp.git"
  },
  "homepage": "https://github.com/edgegap/edgegap-mcp#readme",
  "bugs": {
    "url": "https://github.com/edgegap/edgegap-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@posthog/mcp": "0.22.3",
    "@types/node": "^22.20.2",
    "agents": "^0.28.1",
    "posthog-node": "5.56.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.0"
  },
  "type": "module",
  "bin": {
    "edgegap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
