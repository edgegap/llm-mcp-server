{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgegap-mcp",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // posthog-node optionally imports @opentelemetry/api for trace ids. No
  // OpenTelemetry runs here, so resolve it to a stub with no active span.
  "alias": {
    "@opentelemetry/api": "./otel-api-stub.ts"
  },

  // No KV, D1, R2, or Durable Object bindings — on purpose.
  // The stateless handler needs none, and adding storage here is how a
  // relay quietly becomes a credential vault. See worker.ts.

  // Workers Logs on, matching the dashboard. This file is the source of
  // truth: `wrangler deploy` overwrites dashboard settings with it, so a
  // dashboard-only toggle is undone by the next release.
  //
  // Caution: requests on this Worker carry customer Edgegap API tokens in
  // the Authorization header. Check stored invocation logs never contain
  // them (search the Logs view for "Authorization"). If they do, set
  // "invocation_logs": false and keep logs from the Worker's own output only.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },

  // Do not enable request body logging. Tool arguments and headers on this
  // Worker carry customer API tokens.
  // PostHog MCP Analytics (@posthog/mcp): off until POSTHOG_API_KEY is set.
  // POSTHOG_AGENT_FIELDS "1" turns on intent capture, which adds context,
  // conversation_id and llm_model parameters to every tool (off by default).
  //   npx wrangler secret put POSTHOG_API_KEY --config worker/wrangler.jsonc
  //   npx wrangler secret put TELEMETRY_SALT --config worker/wrangler.jsonc
  // TELEMETRY_SALT (any long random string) hashes tokens into stable,
  // non-reversible distinct_ids; without it every event is anonymous.
  // What is sent, and what never is: worker/telemetry.ts.
  //
  // TELEMETRY_INTERNAL_IDS: org_ ids (PostHog distinct_ids) of Edgegap's own
  // and test tokens, comma-separated, marked is_internal: true. Not secret.
  // Find one in PostHog (the Person of a $mcp_tool_call made with that token)
  // or with `npm run telemetry:id`. Set here, not in the dashboard: a deploy
  // overwrites dashboard vars with this file.
  "vars": {
    "EDGEGAP_MAX_DURATION_MINUTES": "60",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    // Mathieu's token (ends …35ac), added 2026-10-26.
    "TELEMETRY_INTERNAL_IDS": "org_14ded028b92a2f9b25d662d8813b46b5"
  }
}
